# Copy to .env, or use export statements in ~/.bashrc. Shell exports take priority.
# This file is read on process startup, not on every refresh.
TOKEN_OVERLAY_REFRESH_SECONDS=90

# Organization Admin API keys, not ordinary model API keys.
OPENAI_ADMIN_KEY=
OPENAI_ORGANIZATION=
ANTHROPIC_ADMIN_KEY=

# Optional static USD snapshots. These do NOT decrease or refresh automatically.
OPENAI_REMAINING_CREDITS_USD=
CLAUDE_REMAINING_CREDITS_USD=
GOOGLE_CLOUD_REMAINING_CREDITS_USD=

# Vertex online-serving token usage via Cloud Monitoring.
# Set your project ID and grant Monitoring Viewer permissions.
GOOGLE_CLOUD_PROJECT=
# Optional quota project override; defaults to GOOGLE_CLOUD_PROJECT.
GOOGLE_CLOUD_QUOTA_PROJECT=
# Leave empty to obtain fresh tokens through gcloud ADC on each refresh.
# A pasted OAuth access token expires; a Gemini API key does not work here.
GOOGLE_ACCESS_TOKEN=
# GOOGLE_APPLICATION_CREDENTIALS='/absolute/path/to/credentials.json'

# Each adapter replaces its entire row and prints ONE JSON object:
# {"used_tokens": 120000, "remaining_credits": 8.5, "detail": "28 UTC days"}
# No shell expansion; use an executable path and quote commands with arguments.
# GOOGLE_AI_STUDIO_COMMAND='/home/me/bin/aistudio-usage-json'
# GOOGLE_CLOUD_COMMAND=
# CLAUDE_PLATFORM_COMMAND=
# OPENAI_PLATFORM_COMMAND=
